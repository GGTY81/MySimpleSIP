@@ -42,6 +42,26 @@
 
 #include "../pjmedia/ffmpeg_util.h"
 #include <libavcodec/avcodec.h>
+
+/* MySimpleSIP: compatibilidade com FFmpeg >= 7 (libavcodec 61+), onde
+ * avcodec_close() e AVFrame.key_frame foram removidos. */
+static void ff_close_free_ctx(AVCodecContext *ctx, pj_bool_t opened)
+{
+#if LIBAVCODEC_VERSION_MAJOR >= 61
+    PJ_UNUSED_ARG(opened);
+    avcodec_free_context(&ctx);
+#else
+    if (opened)
+        avcodec_close(ctx);
+    av_free(ctx);
+#endif
+}
+
+#if LIBAVCODEC_VERSION_MAJOR >= 61
+#   define FF_FRAME_IS_KEY(f)   (((f).flags & AV_FRAME_FLAG_KEY) != 0)
+#else
+#   define FF_FRAME_IS_KEY(f)   ((f).key_frame)
+#endif
 #include <libavformat/avformat.h>
 #if LIBAVCODEC_VER_AT_LEAST(53,20)
   /* Needed by 264 so far, on libavcodec 53.20 */
